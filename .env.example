# ==================== 环境变量模板 ====================
# 复制为 .env 后填入真实值：
#   cp .env.example .env
# .env 已被 .gitignore 排除，不会提交到仓库。

# ==================== MinerU（PDF 解析）====================
MINERU_API_TOKEN=your_mineru_api_token
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_SOURCE=modelscope
MODELSCOPE_CACHE=
HF_HOME=

# ==================== 临时文件根目录 ====================
MD_ROOT_DIR=

# ==================== LLM（DashScope 兼容 OpenAI 格式）====================
OPENAI_API_KEY=your_dashscope_api_key
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=
LLM_DEFAULT_TEMPERATURE=0.1
VL_MODEL=
ITEM_MODEL=
ITEM_NAME_DIAG=

# ==================== Embedding（BGE）====================
EMBEDDING_MODEL=
EMBEDDING_DIM=1024
BGE_M=
BGE_DEVICE=cpu
BGE_FP=

# ==================== Reranker（BGE）====================
BGE_RERANKER_LARGE=
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP=

# ==================== Milvus（向量库）====================
MILVUS_URL=http://localhost:19530
CHUNKS_COLLECTION=
ITEM_NAME_COLLECTION=
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=

# ==================== MongoDB ====================
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=

# ==================== MinIO（对象存储）====================
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=

# ==================== MCP ====================
MCP_DASHSCOPE_BASE_URL=
